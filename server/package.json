{
  "name": "seattle-food-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --import tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "reset-demo": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --import tsx scripts/reset-demo.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.2.0",
    "typescript": "~5.9"
  }
}
