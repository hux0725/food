# Copy this file to server/.env and fill in what you need.
# Nothing here is required: every value has a safe default.
# server/.env is gitignored. Never commit real keys. Never put a key in a VITE_ variable.

# development | production | test  (`npm start` forces production)
NODE_ENV=development

# Port for the API (and, in production, the web app). Hosting platforms set this for you.
PORT=3001

# Optional. Defaults to 127.0.0.1 locally and 0.0.0.0 in production.
# HOST=127.0.0.1

# SQLite database file and assistant cache, relative to server/. Created automatically.
DB_PATH=./data/bite.db
CACHE_PATH=./data/assistant-cache.json

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Live AI assistant (optional) ---
# Leave LLM_API_KEY empty to run on the demo cache and the local matcher only.
# LLM_API_KEY is a Google (Gemini) API key from https://aistudio.google.com/apikey.
# LLM_MODEL is required when a key is set. Pick a fast model with thinking off by default (gemini-2.5-flash-lite):
# thinking models can be too slow for the 6 second answer deadline, and the app then falls back to basic matching.
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash-lite
LLM_API_KEY=

# Show which path answered (llm / cache / local) under each assistant reply. Also available per page with ?debug=1.
DEMO_DEBUG=false

# In-app "add an API key" prompt. Defaults to on in development and off in production (npm start).
# AI_KEY_PROMPT=on
